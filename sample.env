# Copy to .env and fill in the values you use.
# Environment values win over the same settings saved in the admin UI.

# --- Database (Neon on Vercel) ---
# Leave unset in local preview. The app then uses a built-in database.
# On Vercel, paste the Neon integration variables. Any one of these is enough
# for the running app. Migrations prefer the unpooled URL when it is set.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# Do not commit the real password. Set the values in the Vercel project, not in git.

# --- Auth ---
# Set to false to skip sign-in and use the local dev user.
# VITE_AUTH_ENABLED=true
# The first signed-in person is a customer. Set this only to create the first owner
# when the staff table is empty. It does nothing once an owner exists.
# BOOTSTRAP_OWNER_EMAIL=
# BETTER_AUTH_SECRET=replace-with-a-long-random-string
# BETTER_AUTH_URL=https://portal.managetechservice.com
# Google and Microsoft return to https://portal.managetechservice.com/login
# Auth0 (Vercel Auth0 integration). Set these on the Vercel project, not in git.
# The Auth0 application must allow this callback:
#   https://your-domain.example/api/auth/oauth2/callback/auth0
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=
# Management API credentials are not used for sign-in.
# AUTH0_MANAGEMENT_API_CLIENT_ID=
# AUTH0_MANAGEMENT_API_CLIENT_SECRET=
# Customer sign-in. Staff and admin still use the invited email and password.
# Register these redirect URLs on the Google and Microsoft apps:
#   https://portal.managetechservice.com/api/auth/oauth2/callback/google
#   https://portal.managetechservice.com/api/auth/oauth2/callback/microsoft
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Federated Google and Microsoft sign-in. The deployer injects these when published.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# --- Zendesk ---
# Support API. mtsportal is an authorization-code client, so it does not mint tokens by itself.
# Ticket read and write need ZENDESK_EMAIL plus ZENDESK_API_TOKEN. The Conversations key is the shared connection.
# ZENDESK_SUBDOMAIN=managetechservices-16737
# ZENDESK_OAUTH_CLIENT_ID=managetech
# ZENDESK_OAUTH_CLIENT_SECRET=
# ZENDESK_OAUTH_SCOPES=read write
# ZENDESK_OAUTH_TOKEN_URL=https://managetechservices-16737.zendesk.com/oauth/tokens
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# Sarah pauses the action recovery sweep when this is 0. Leave unset in production.
# SARAH_ACTION_ENGINE=1
# Conversations API (messaging). These are not the Support API token.
# ZENDESK_CONVERSATIONS_APP_ID=
# ZENDESK_CONVERSATIONS_KEY_ID=
# ZENDESK_CONVERSATIONS_SECRET=
# Signed webhook. Point Zendesk at https://your-domain/api/zendesk/webhook
# ZENDESK_WEBHOOK_ID=
# ZENDESK_WEBHOOK_SECRET=
# ZENDESK_EVENT_WEBHOOK_ID=
# ZENDESK_EVENT_WEBHOOK_SECRET=

# --- UPS tracking ---
# Used when a warehouse scan reads a 1Z air waybill.
# Leave UPS_ENV unset for the live UPS API. Set sandbox only for CIE test labels.
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# UPS_ENV=production

# Hourly job drain. Vercel sends this as Authorization: Bearer.
# CRON_SECRET=
# Customer email. Both are required before a message leaves the portal.
# RESEND_API_KEY=
# EMAIL_FROM=Manage Tech Service <noreply@managetech.cloudgpu.site>
# --- Stripe (card payments) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Alternative Payments sandbox ---
# Generated sandbox pair for the shop card capture. Replace with the partner keys
# from go.alternativepayments.io when the live gateway is ready.
ALTERNATIVE_ENV=sandbox
ALTERNATIVE_CLIENT_ID=
ALTERNATIVE_CLIENT_SECRET=
ALTERNATIVE_API_BASE=https://public-api.demo.alternativepayments.io
# Signs webhooks at POST /api/payments/alternative. Required on any deployed build.
ALTERNATIVE_WEBHOOK_SECRET=

# --- Zendesk messaging extras ---
ZENDESK_CONVERSATION_WEBHOOK_SECRET=
# Account > Security > End user authentication > Auth Services signing key.
# The portal signs a one-hour JWT with this key after a customer signs in.
ZENDESK_END_USER_JWT_KEY_ID=
ZENDESK_END_USER_JWT_SECRET=

# --- Sarah call (LiveKit) ---
# The browser joins this LiveKit room; the mts-agent worker must run in the same project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- MTS Agent models and voice ---
# Local model CLIs on the machine that runs this app. Leave blank to use the defaults.
OLLAMA_HOST=http://127.0.0.1:11434
OPENCODE_HOST=http://127.0.0.1:4096
# Used when OpenRouter has no key saved in the admin portal.
OPENROUTER_API_KEY=
XAI_API_KEY=
# ElevenLabs read-aloud.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Gemini Live voice for the customer-portal call only.
GEMINI_CSR_API_KEY=
GEMINI_CSR_MODEL=gemini-3.8-live
GEMINI_CSR_VOICE=Zephyr
